package com.veratech.app

import android.app.Activity
import android.content.Context
import android.content.Intent
import android.graphics.Color
import android.graphics.Typeface
import android.net.TrafficStats
import android.net.VpnService
import android.os.Bundle
import android.os.Handler
import android.os.Looper
import android.view.Gravity
import android.widget.*
import com.wireguard.android.backend.GoBackend
import com.wireguard.android.backend.Tunnel
import com.wireguard.config.Config
import com.wireguard.config.InetEndpoint
import com.wireguard.config.InetNetwork
import com.wireguard.config.Interface
import com.wireguard.config.Peer
import java.net.InetAddress
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale

class MainActivity : Activity() {
    private lateinit var backend: GoBackend
    private val tunnel = object : Tunnel {
        override fun getName() = "veratech"
        override fun onStateChange(newState: Tunnel.State) {}
    }
    private val handler = Handler(Looper.getMainLooper())
    private lateinit var status: TextView
    private lateinit var btn: Button
    private lateinit var usage: TextView
    private lateinit var logView: TextView
    private lateinit var spinner: Spinner
    private val dnsNames = listOf("Cloudflare 1.1.1.1", "Google 8.8.8.8", "AdGuard (ads block)", "Quad9 9.9.9.9")
    private val dnsIps = listOf("1.1.1.1", "8.8.8.8", "94.140.14.14", "9.9.9.9")
    private var busy = false

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        backend = GoBackend(applicationContext)
        buildUi()
        refresh()
        tick.run()
    }

    private fun buildUi() {
        val root = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setBackgroundColor(Color.parseColor("#0F1720"))
            setPadding(48, 96, 48, 48)
        }
        fun tv(size: Float, color: String, bold: Boolean = false) = TextView(this).apply {
            textSize = size; setTextColor(Color.parseColor(color))
            if (bold) setTypeface(null, Typeface.BOLD)
        }
        root.addView(tv(30f, "#FFFFFF", true).apply { text = "Veratech" })
        root.addView(tv(14f, "#8FA3B5").apply { text = "WARP VPN + DNS + Data Monitor" })
        status = tv(20f, "#FF6B6B", true).apply { setPadding(0, 64, 0, 24); gravity = Gravity.CENTER }
        root.addView(status, LinearLayout.LayoutParams(-1, -2))
        btn = Button(this).apply { setOnClickListener { onToggle() } }
        root.addView(btn, LinearLayout.LayoutParams(-1, 160))
        root.addView(tv(14f, "#8FA3B5").apply { text = "DNS server"; setPadding(0, 48, 0, 8) })
        spinner = Spinner(this).apply {
            adapter = ArrayAdapter(this@MainActivity, android.R.layout.simple_spinner_dropdown_item, dnsNames)
            setSelection(getSharedPreferences("app", Context.MODE_PRIVATE).getInt("dns", 0))
        }
        root.addView(spinner)
        root.addView(tv(14f, "#8FA3B5").apply { text = "Data usage (phone boot se)"; setPadding(0, 48, 0, 8) })
        usage = tv(16f, "#FFFFFF")
        root.addView(usage)
        root.addView(tv(14f, "#8FA3B5").apply { text = "Logs"; setPadding(0, 48, 0, 8) })
        logView = tv(12f, "#B8C7D6")
        root.addView(ScrollView(this).apply { addView(logView) }, LinearLayout.LayoutParams(-1, 0, 1f))
        setContentView(root)
    }

    private fun log(msg: String) {
        val t = SimpleDateFormat("HH:mm:ss", Locale.US).format(Date())
        runOnUiThread { logView.text = "$t  $msg\n${logView.text}" }
    }

    private fun isUp() = try { backend.getState(tunnel) == Tunnel.State.UP } catch (e: Exception) { false }

    private fun refresh() {
        val up = isUp()
        status.text = if (up) "CONNECTED" else "DISCONNECTED"
        status.setTextColor(Color.parseColor(if (up) "#4ADE80" else "#FF6B6B"))
        btn.text = if (busy) "Please wait..." else if (up) "Disconnect" else "Connect"
        btn.isEnabled = !busy
    }

    private fun onToggle() {
        if (isUp()) { setTunnel(false); return }
        getSharedPreferences("app", Context.MODE_PRIVATE).edit().putInt("dns", spinner.selectedItemPosition).apply()
        val i = VpnService.prepare(this)
        if (i != null) startActivityForResult(i, 1) else setTunnel(true)
    }

    @Deprecated("Deprecated in Java")
    override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
        super.onActivityResult(requestCode, resultCode, data)
        if (requestCode == 1 && resultCode == RESULT_OK) setTunnel(true) else if (requestCode == 1) log("VPN permission denied")
    }

    private fun setTunnel(up: Boolean) {
        busy = true; refresh()
        Thread {
            try {
                if (up) {
                    log("Registering WARP / building config...")
                    Warp.ensureRegistered(this)
                    backend.setState(tunnel, Tunnel.State.UP, buildConfig())
                    log("Connected via WARP, DNS ${dnsNames[spinner.selectedItemPosition]}")
                } else {
                    backend.setState(tunnel, Tunnel.State.DOWN, null)
                    log("Disconnected")
                }
            } catch (e: Exception) {
                log("Error: ${e.message}")
            }
            busy = false
            runOnUiThread { refresh() }
        }.start()
    }

    private fun buildConfig(): Config {
        val sp = getSharedPreferences("warp", Context.MODE_PRIVATE)
        val iface = Interface.Builder()
            .parsePrivateKey(sp.getString("priv", "")!!)
            .addAddress(InetNetwork.parse(sp.getString("v4", "")!! + "/32"))
            .addAddress(InetNetwork.parse(sp.getString("v6", "")!! + "/128"))
            .addDnsServer(InetAddress.getByName(dnsIps[spinner.selectedItemPosition]))
            .setMtu(1280)
            .build()
        val peer = Peer.Builder()
            .parsePublicKey(sp.getString("peer", "")!!)
            .addAllowedIp(InetNetwork.parse("0.0.0.0/0"))
            .addAllowedIp(InetNetwork.parse("::/0"))
            .setEndpoint(InetEndpoint.parse("engage.cloudflareclient.com:2408"))
            .build()
        return Config.Builder().setInterface(iface).addPeer(peer).build()
    }

    private fun mb(b: Long) = String.format(Locale.US, "%.1f MB", b / 1048576.0)

    private val tick = object : Runnable {
        override fun run() {
            val total = TrafficStats.getTotalRxBytes() + TrafficStats.getTotalTxBytes()
            val mobile = TrafficStats.getMobileRxBytes() + TrafficStats.getMobileTxBytes()
            usage.text = "Mobile data: ${mb(mobile)}\nWiFi/other: ${mb(maxOf(0, total - mobile))}\nTotal: ${mb(total)}"
            handler.postDelayed(this, 2000)
        }
    }

    override fun onDestroy() { handler.removeCallbacksAndMessages(null); super.onDestroy() }
}
